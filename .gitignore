# ==============================================================================
# AI Proctoring Engine Git Ignore Rules
# ==============================================================================

# Python Bytecode & Intermediates
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Jupyter Notebooks
.ipynb_checkpoints/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS Metadata
.DS_Store
Thumbs.db

# Python Tooling & Caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Runtime Logs
*.log
logs/

# AI Datasets & Raw Captures
data/*
!data/.gitkeep
datasets/
*.zip
*.tar.gz
*.tgz

# Model Checkpoints & Large Weights
models/*
!models/.gitkeep
weights/*
!weights/.gitkeep
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.h5
*.keras
*.bin
*.engine
checkpoints/
runs/
training/
wandb/

# Test & Validation Results
coverage/
test-results/
stress-test-results/
final-test-results/
final-validation-results/

# Cryptographic Keys & Keystores
*.jks
*.keystore
*.pem
*.key
*.p12
*.pfx

# Dependency directories
node_modules/
vendor/
target/
.gradle/

# Temporary Files
tmp/
temp/
scratch/

# Docker Build & Data
docker-data/

# Generated Session Evidence Packages
data/results/
data/evidence_packages/
