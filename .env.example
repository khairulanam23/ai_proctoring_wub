# AI Proctoring System - Environment Variables Template
# Copy this file to .env for local hardware/development configuration.
# DO NOT commit real secrets or tokens to version control.

# Host & Port Binding
AI_HOST=0.0.0.0
AI_PORT=7001
AI_WORKERS=1

# GPU & Hardware Configuration
CUDA_VISIBLE_DEVICES=0

# Camera Hardware Configuration (optional direct webcam capture)
# Specify the integer index or device path of the preferred video capture device.
# If omitted or left blank, the system automatically discovers available indices (0-5).
# PROCTORING_CAMERA_INDEX=0

# Python Logging
PYTHONUNBUFFERED=1
